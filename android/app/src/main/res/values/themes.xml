<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema de plataforma mínimo (não usa a biblioteca com.google.android.material,
        que não é dependência deste projeto). A paleta/tipografia reais estão em
        ui/theme/ (Compose). A barra de estado e de navegação são transparentes e o
        conteúdo desenha por baixo (edge-to-edge, obrigatório no Android 15+): ver
        MainActivity.enableEdgeToEdge().
    -->
    <style name="Theme.AquaVitae" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Ecrã de arranque do sistema (emblema sobre fundo branco); passa a Theme.AquaVitae quando a app arranca. -->
    <style name="Theme.AquaVitae.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.AquaVitae</item>
    </style>
</resources>
